    {
      "name": "01 - Auth - Register admin success",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{ms7Url}}/api/auth/register",
          "host": [
            "{{ms7Url}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nom\": \"Admin Test\",\n  \"email\": \"{{adminEmail}}\",\n  \"motDePasse\": \"{{adminPassword}}\",\n  \"role\": \"ADMIN\",\n  \"telephone\": \"0600000001\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Admin register returns 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "pm.test('Admin register returns token and user profile', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('token');",
              "  pm.expect(body).to.have.property('userId');",
              "  pm.expect(body.email).to.eql(pm.environment.get('adminEmail'));",
              "  pm.expect(body.role).to.eql('ADMIN');",
              "  pm.environment.set('adminUserId', body.userId);",
              "  pm.environment.set('adminRegisterToken', body.token);",
              "});"
            ]
          }
        }
      ]
    },
