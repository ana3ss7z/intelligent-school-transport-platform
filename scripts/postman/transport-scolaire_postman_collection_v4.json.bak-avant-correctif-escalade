  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('adminEmail')) {",
          "  const runId = Date.now().toString();",
          "  pm.environment.set('runId', runId);",
          "  pm.environment.set('adminEmail', `admin.${runId}@transport.local`);",
          "  pm.environment.set('parentEmail', `parent.${runId}@transport.local`);",
          "  pm.environment.set('chauffeurEmail', `chauffeur.${runId}@transport.local`);",
          "  pm.environment.set('adminPassword', 'Admin123!');",
          "  pm.environment.set('parentPassword', 'Parent123!');",
          "  pm.environment.set('chauffeurPassword', 'Chauffeur123!');",
          "  pm.environment.set('busMatricule', `BUS-${runId}`);",
          "  pm.environment.set('busMatriculeUpdated', `BUS-${runId}-UPD`);",
          "  pm.environment.set('eleveNom', `Eleve-${runId}`);",
          "  pm.environment.set('elevePrenom', 'Test');",
          "  // MS8 Gateway specific",
          "  pm.environment.set('gwAdminEmail', `gwadmin.${runId}@transport.local`);",
          "  pm.environment.set('gwBusMatricule', `GW-BUS-${runId}`);",
          "}",
          "pm.environment.set('invalidPassword', 'wrong-password');"
        ]
      }
    }
  ],
