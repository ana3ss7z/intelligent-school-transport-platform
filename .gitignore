# ====================================================================
# Fichier .gitignore - Projet PFE Smart Transport Scolaire (Master SDIA)
# ====================================================================

# 1. Dossiers de build et compilation (Java / Maven)
# ====================================================================
**/target/
*.class
*.mars
*.vm
*.log

# Ignorer le wrapper Maven si vous préférez utiliser votre Maven local
# .mvn/
# mvnw
# mvnw.cmd

# 2. Données cartographiques lourdes (OSRM) - À NE JAMAIS POUSSER
# ====================================================================
/osrm-data/

# 3. Sécurité et Secrets (Critique)
# ====================================================================
**/firebase-service-account.json
*.env
.env.*

# 4. Environnements virtuels et cache (Python / IA)
# ====================================================================
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt
.history/

# 5. Fichiers temporaires, logs de test et dumps textuels du workspace
# ====================================================================
/project_dump.txt
/important_project_dump.txt
/New Text Document.txt
/test_results_2.txt
**/postman/test_results*.txt

# 6. Configuration des IDEs (VS Code, IntelliJ, Eclipse)
# ====================================================================
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/launch.json
.settings/
.classpath
.project
.factorypath


.claude/
graphify-out/
.graphifyignore
*.png

# Exceptions : icônes de l'app Flutter parent. `*.png` est ignoré globalement
# ci-dessus (dumps/captures), mais ces PNG sont des SOURCES du projet — sans eux
# un clone frais n'a aucune icône d'application.
!frontend/parent-mobile/assets/icon/*.png
!frontend/parent-mobile/android/app/src/main/res/mipmap-*/*.png
!frontend/parent-mobile/web/icons/*.png
!frontend/parent-mobile/web/favicon.png

# Idem pour l'app Flutter chauffeur.
!frontend/chauffeur-mobile/assets/icon/*.png
!frontend/chauffeur-mobile/android/app/src/main/res/mipmap-*/*.png
!frontend/chauffeur-mobile/web/icons/*.png
!frontend/chauffeur-mobile/web/favicon.png


# Comptes générés (mots de passe en clair — ne jamais committer)
comptes_utilisateurs.*
#les tests html
/html_tests/
# Frontend (Node/Bun/Flutter)
frontend/**/node_modules/
frontend/**/dist/
frontend/**/.vite/
frontend/**/build/

# Profils Chrome persistants des lanceurs Flutter web (.vscode/launch.json).
# Sans --user-data-dir, `flutter run -d chrome` repart d'un profil temporaire : la permission
# de notification et le jeton FCM seraient réinitialisés à chaque lancement.
.chrome-profile-*/
